# ------------------------------------------------------------
# Compose project and container names
# ------------------------------------------------------------
COMPOSE_PROJECT_NAME=bokser_app_dev

MIGRATE_CONTAINER_NAME=bokser_app_migrate_dev
API_CONTAINER_NAME=bokser_app_api_dev
WORKER_CONTAINER_NAME=bokser_app_worker_dev

DB_NET_NAME=bokser_app_dev_db_net
DB_NET_EXTERNAL=false

# ------------------------------------------------------------
# Docker image
# ------------------------------------------------------------
APP_IMAGE=bokser_app_dev:latest

# ------------------------------------------------------------
# App settings
# ------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO

LAKE_ROOT=/data_lake
LOGS_ROOT=/app/logs
LOG_DIR=/app/logs

DOWNLOADS_ROOT=/app/downloads
NAS_DOWNLOAD_PATH=/app/downloads

REPORTING_ARCHIVE_ROOT=/app/reporting_archive
NAS_REPORT_ARCHIVE=/app/reporting_archive

AUTO_CREATE_TABLES=false

# ------------------------------------------------------------
# Postgres
# ------------------------------------------------------------
POSTGRES_SERVER=10.1.10.10
POSTGRES_PORT=5434
POSTGRES_USER=bokser_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bokser_app_db

# ------------------------------------------------------------
# Host paths and ports
# ------------------------------------------------------------
API_HOST_PORT=8000

LAKE_HOST_PATH=C:/Users/erik/Code/data_lake/dev
LOGS_HOST_PATH=C:/Users/erik/Code/bokser_app/logs
DOWNLOADS_HOST_PATH=C:/Users/erik/Code/test_downloads
REPORTING_ARCHIVE_HOST_PATH=Z:/Operations/Reports/Reporting_Archive


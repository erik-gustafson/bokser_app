# Reviewed deployment draft, 2026-10-10. Merge into existing PRIVATE settings.
# Target database confirmed by Erik; Bokser Home/company 2 proposed pending confirmation.
# Do not enable before reviewed reference mappings, backup, addon upgrade and pilot.
SOS_MIRROR_JOB_ENABLED=false
SOS_MIRROR_SOURCE_OWNER_CONFIRMED=true
SOS_MIRROR_ACCOUNT_CODE=bokser-sos-prod
SOS_MIRROR_COMPANY_ID=2
SOS_MIRROR_ODOO_DATABASE=bokser_test
SOS_MIRROR_ODOO_URL=https://odoo.bokser.internal:8443
SOS_MIRROR_USE_EXISTING_LAKE=true
SOS_MIRROR_JOURNAL_ROOT=/app/private_state/sos_odoo_mirror
SOS_MIRROR_CUSTOM_FIELD_IDS=[1,7]
SOS_MIRROR_INTERVAL_MINUTES=5
SOS_MIRROR_RECONCILIATION_HOURS=24
SOS_MIRROR_DELIVERY_LIMIT=1000
# Supply SOS_MIRROR_ODOO_API_KEY privately for a company-scoped service user.
# Supply SOS_MIRROR_ODOO_CA_BUNDLE using the existing mounted Odoo trust bundle.
# Odoo: bokser_sos_mirror.enabled=false; direction=sos_to_odoo;
# transaction_cutoff=2026-01-01; account approved_custom_field_ids=["1","7"].

# Copy to terminal49.env, restrict access and keep out of git.
# Env file paths resolve relative to the first Compose file (docker/).
TERMINAL49_ENABLED=true
TERMINAL49_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bokser_app_db
TERMINAL49_ACCOUNT_CODE=bokser-terminal49
TERMINAL49_ODOO_COMPANY_ID=1
TERMINAL49_API_KEY=
TERMINAL49_WEBHOOK_SECRET=
# Generate a random token of at least 32 characters. Reuse in Odoo connection.
TERMINAL49_PULL_TOKEN=
# Must match the container side of the existing lake volume.
TERMINAL49_LAKE_ROOT=/data_lake
TERMINAL49_REQUEST_INTERVAL_SECONDS=1
TERMINAL49_RECONCILE_MINUTES=60
TERMINAL49_MAX_ATTEMPTS=8

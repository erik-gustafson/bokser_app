# Copy into a separate protected environment file. Never commit credentials.
# Use only synthetic sandbox data in v0.2; no automatic jobs are registered.
AMAZON_ENVIRONMENT=sandbox
AMAZON_ENABLED=false
AMAZON_OWNER=bokser
AMAZON_WRITES_ENABLED=false
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
AMAZON_INVENTORY_INTERVAL_MINUTES=15
# Maximum stock age remains a required launch choice. Omit until decided.
# AMAZON_STOCK_MAX_AGE_MINUTES=...
AMAZON_INVENTORY_BUFFER=0
# Optional per-connector cap. Product-specific settings belong in Odoo mapping.
# AMAZON_INVENTORY_CAP=...
AMAZON_SEARCH_MIN_INTERVAL_SECONDS=180
AMAZON_SHIPMENT_MIN_INTERVAL_SECONDS=0.5
AMAZON_INVENTORY_MIN_INTERVAL_SECONDS=0.2
AMAZON_HTTP_TIMEOUT_SECONDS=30

# Separate synthetic account. Must match the Odoo Amazon Sandbox account.
AMAZON_ACCOUNT_CODE=amazon-demo
# Set seller ID above to test-seller for --demo; LWA credentials are not required.
# Replace placeholders locally, never paste passwords into a ticket or chat.
AMAZON_DATABASE_URL=postgresql://amazon_app:REPLACE_WITH_URL_ENCODED_PASSWORD@bokser_amazon_db:5432/amazon_orders
AMAZON_ODOO_URL=https://REPLACE_WITH_PRIVATE_ODOO_HOST
AMAZON_ODOO_DATABASE=bokser_amazon_sandbox
AMAZON_ODOO_API_KEY=
AMAZON_INITIAL_SYNC_AT=2026-10-01T00:00:00Z

#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

APP_DIR="/volume1/Bokser_Home/Code/bokser_app"
LOG="/var/log/git-deploy-staging.log"
BRANCH_EXPECTED="dev"
BASE_COMPOSE="docker/docker-compose.yml"
ENV_FILE="docker/.env"
HEALTH_URL="http://127.0.0.1:8011/health/status"
HEALTH_RETRIES=30
HEALTH_SLEEP=2
LOG_SERVICES=("bokser_app_api" "bokser_app_worker")

export PATH="/usr/bin:/usr/local/bin:$PATH"

COMPOSE_MODE=""
COMPOSE_BIN=""
DOCKER_BIN="$(command -v docker || true)"
if [ -x /usr/local/bin/docker-compose ]; then
  COMPOSE_MODE="v1"
  COMPOSE_BIN="/usr/local/bin/docker-compose"
elif [ -n "$DOCKER_BIN" ] && "$DOCKER_BIN" compose version >/dev/null 2>&1; then
  COMPOSE_MODE="v2"
else
  echo "ERROR: Neither docker-compose nor 'docker compose' found." | tee -a "$LOG"
  exit 1
fi

run_compose() {
  if [ "$COMPOSE_MODE" = "v1" ]; then
    "$COMPOSE_BIN" "$@"
  else
    "$DOCKER_BIN" compose "$@"
  fi
}

DEPLOY=0
OLDREV=""
NEWREV=""
while IFS=' ' read -r oldrev newrev ref _; do
  ref="${ref:-}"
  [ -z "$ref" ] && continue
  ref="${ref%$'\r'}"
  branch="${ref#refs/heads/}"
  echo "post-receive: ref='$ref' (branch='$branch')" | tee -a "$LOG"
  if [ "$ref" = "refs/heads/${BRANCH_EXPECTED}" ] || [ "$branch" = "${BRANCH_EXPECTED}" ]; then
    DEPLOY=1
    OLDREV="$oldrev"
    NEWREV="$newrev"
  fi
done

[ "$DEPLOY" -eq 1 ] || {
  echo "Skipping deploy (no '$BRANCH_EXPECTED' in push)" | tee -a "$LOG"
  exit 0
}

[ -d "$APP_DIR" ] || {
  echo "ERROR: APP_DIR '$APP_DIR' not found" | tee -a "$LOG"
  exit 1
}
[ -f "$APP_DIR/$ENV_FILE" ] || {
  echo "ERROR: Missing $APP_DIR/$ENV_FILE" | tee -a "$LOG"
  exit 1
}
[ -f "$APP_DIR/$BASE_COMPOSE" ] || {
  echo "ERROR: Missing compose file in $APP_DIR" | tee -a "$LOG"
  exit 1
}

checkout_rev() {
  local rev="$1"
  echo "Checking out '$rev' to $APP_DIR" | tee -a "$LOG"
  git --work-tree="$APP_DIR" --git-dir="$PWD" checkout -f "$rev" 2>&1 | tee -a "$LOG"
  git --work-tree="$APP_DIR" --git-dir="$PWD" clean -fd 2>&1 | tee -a "$LOG"
}

health_check() {
  echo "Health-check: $HEALTH_URL" | tee -a "$LOG"
  for i in $(seq 1 "$HEALTH_RETRIES"); do
    if curl -fsS "$HEALTH_URL" >/dev/null 2>&1; then
      echo "Healthy after $i attempt(s)" | tee -a "$LOG"
      return 0
    fi
    sleep "$HEALTH_SLEEP"
  done
  echo "Health-check failed after $HEALTH_RETRIES attempts" | tee -a "$LOG"
  return 1
}

deploy_current() {
  cd "$APP_DIR"
  echo "Staging: down..." | tee -a "$LOG"
  run_compose --env-file "$ENV_FILE" -f "$BASE_COMPOSE" down 2>&1 | tee -a "$LOG" || true
  echo "Staging: build..." | tee -a "$LOG"
  run_compose --env-file "$ENV_FILE" -f "$BASE_COMPOSE" build 2>&1 | tee -a "$LOG"
  echo "Staging: up..." | tee -a "$LOG"
  run_compose --env-file "$ENV_FILE" -f "$BASE_COMPOSE" up -d 2>&1 | tee -a "$LOG"
}

log_diagnostics() {
  run_compose --env-file "$ENV_FILE" -f "$BASE_COMPOSE" ps 2>&1 | tee -a "$LOG" || true
  run_compose --env-file "$ENV_FILE" -f "$BASE_COMPOSE" logs --tail 200 "${LOG_SERVICES[@]}" 2>&1 | tee -a "$LOG" || true
}

rollback_to_old() {
  echo "ROLLBACK: reverting to previous rev $OLDREV" | tee -a "$LOG"
  checkout_rev "$OLDREV"
  deploy_current
  if health_check; then
    echo "Rollback succeeded" | tee -a "$LOG"
  else
    echo "Rollback unhealthy - diagnostics follow:" | tee -a "$LOG"
    log_diagnostics
  fi
}

checkout_rev "$NEWREV"
deploy_current
if health_check; then
  echo "Staging deploy healthy for $NEWREV @ $(date)" | tee -a "$LOG"
  exit 0
fi

echo "New revision unhealthy, collecting diagnostics..." | tee -a "$LOG"
log_diagnostics
rollback_to_old
exit 1

#!/usr/bin/env bash
set -euo pipefail

require_remote() {
  local name="$1"
  if ! git remote get-url "$name" >/dev/null 2>&1; then
    echo "Remote '$name' is not configured." >&2
    exit 1
  fi
}

require_remote origin
require_remote staging

git fetch origin dev

DEV_SHA="$(git rev-parse --verify refs/remotes/origin/dev^{commit})"

echo "Deploying origin/dev (${DEV_SHA}) to staging/dev"
git push staging "${DEV_SHA}:refs/heads/dev"
echo "Staging deploy push complete."

